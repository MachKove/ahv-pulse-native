{
  "productName": "AHV PULSE",
  "version": "1.0.0",
  "identifier": "com.ahv.pulse",
  "build": {
    "frontendDist": "../src",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "title": "AHV PULSE",
        "width": 1200,
        "height": 800
      }
    ],
    "security": {
      "csp": "default-src 'self' https:; img-src 'self' data: https:; style-src 'self' 'unsafe-inline' https:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi",
      "nsis"
    ],
    "icon": [
      "icons/icon.png"
    ],
    "category": "Productivity"
  }
}